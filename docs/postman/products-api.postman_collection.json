{
  "info": {
    "name": "Products API",
    "description": "Endpoints de la API con datos de prueba.\n\n1. Importa y selecciona el entorno **Local** (`baseUrl = http://localhost:8000/api`). Para otro servidor, duplícalo y cambia `baseUrl`.\n2. Ejecuta la colección en orden con el Runner, o empieza por **Divisas → Listar divisas** y **Productos → Crear producto** si vas petición a petición: guardan los UUID que usan las demás.\n\nCada petición comprueba su código de respuesta.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "usd_id",
      "value": ""
    },
    {
      "key": "eur_id",
      "value": ""
    },
    {
      "key": "mxn_id",
      "value": ""
    },
    {
      "key": "cop_id",
      "value": ""
    },
    {
      "key": "product_id",
      "value": ""
    },
    {
      "key": "big_product_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Divisas",
      "description": "Catálogo de divisas (solo lectura). Ejecuta primero esta petición: guarda los UUID de cada divisa en variables.",
      "item": [
        {
          "name": "Listar divisas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.response.json().data.forEach(c => pm.collectionVariables.set(c.name.toLowerCase() + \"_id\", c.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/currencies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "currencies"
              ]
            },
            "description": "Devuelve USD, EUR, MXN y COP. Guarda `usd_id`, `eur_id`, `mxn_id` y `cop_id`."
          }
        }
      ]
    },
    {
      "name": "Productos",
      "description": "CRUD de productos.",
      "item": [
        {
          "name": "Crear producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"product_id\", pm.response.json().data.id);",
                  "pm.test(\"precio formateado\", () => pm.expect(pm.response.json().data.price).to.eql(\"150.00\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "description": "Crea un producto en USD y guarda su UUID en `product_id`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Silla ergonómica\",\n  \"description\": \"Silla de oficina con soporte lumbar y reposabrazos ajustables\",\n  \"price\": 150.0,\n  \"currency_id\": \"{{usd_id}}\",\n  \"tax_cost\": 24.0,\n  \"manufacturing_cost\": 80.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Listar productos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "description": "Lista paginada (15 por página por defecto), del más reciente al más antiguo, con la divisa base de cada producto."
          }
        },
        {
          "name": "Buscar productos por nombre",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"encuentra la silla\", () => pm.expect(pm.response.json().data[0].name).to.eql(\"Silla ergonómica\"));"
                ]
