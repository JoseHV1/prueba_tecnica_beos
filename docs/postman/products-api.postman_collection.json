            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Silla ergonómica Pro\",\n  \"description\": \"Silla de oficina con soporte lumbar y reposabrazos ajustables\",\n  \"price\": 175.5,\n  \"currency_id\": \"{{usd_id}}\",\n  \"tax_cost\": 24.0,\n  \"manufacturing_cost\": 80.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
